---
import type { Language } from '../utils/i18n';
import { getHrefLangPath, ogLocales, languages } from '../utils/i18n';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Language;
  title: string;
  description: string;
  ogImage?: string;
  pageKey: string;
  articleData?: {
    title: string;
    excerpt: string;
    author: string;
    date: string;
    image: string;
    dateModified?: string;
  };
  extraSchemas?: Record<string, unknown>[];
}

const { lang, title, description, ogImage, pageKey, articleData, extraSchemas = [] } = Astro.props;

const siteUrl = 'https://aqarproperty.co.uk';
const canonicalUrl = new URL(getHrefLangPath(lang, pageKey), siteUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : new URL('/og-default.jpg', siteUrl).href;
const locale = lang === 'en' ? 'en-GB' : 'fr-FR';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AQAR Property Management',
  alternateName: 'Aqar',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description: lang === 'en'
    ? 'Uganda-first property management software for rent operations, tenant self-service, landlord reporting, maintenance, inspections, documents, and compliance-aware workflows.'
    : 'Logiciel de gestion immobiliere pour les operations locatives, le self-service locataire, les rapports proprietaires, la maintenance, les inspections, les documents et les processus sensibles a la conformite.',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+256-784-464178',
    contactType: 'customer service',
    availableLanguage: ['English', 'French'],
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sserumaga Road, Bukoto',
    addressLocality: 'Kampala',
    addressCountry: 'UG',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AQAR Property Management',
  url: siteUrl,
  inLanguage: locale,
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'WebApplication'],
  name: 'AQAR Property Management',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web browser',
  description: lang === 'en'
    ? 'Cloud-based property management software for landlords, property managers, accountants, tenants, and platform administrators.'
    : 'Logiciel de gestion immobiliere en ligne pour proprietaires, gestionnaires, comptables, locataires et administrateurs de plateforme.',
  url: siteUrl,
  inLanguage: locale,
  featureList: lang === 'en'
    ? ['Portfolio dashboard', 'Property and unit management', 'Tenant identity and lease records', 'Rent invoicing', 'Payment proof verification', 'Receipts', 'Landlord remittances', 'Maintenance tracking', 'Inspection evidence', 'Document control', 'Role-based access control', 'Audit trails', 'Excel import and export']
    : ['Tableau de bord portefeuille', 'Gestion des biens et unites', 'Identite locataire et dossiers de bail', 'Facturation des loyers', 'Verification des preuves de paiement', 'Recus', 'Versements aux proprietaires', 'Suivi de maintenance', 'Preuves d inspection', 'Gestion documentaire', 'Controle d acces par role', 'Journaux d audit', 'Import et export Excel'],
  publisher: {
    '@type': 'Organization',
    name: 'Chwezi Core Systems',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1A1F2E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:type" content={articleData ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    {languages.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(getHrefLangPath(l, pageKey), siteUrl).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getHrefLangPath('en', pageKey), siteUrl).href} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {pageKey === '' && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {(pageKey === '' || pageKey === 'features') && <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />}

    {articleData && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: articleData.title,
        description: articleData.excerpt,
        image: articleData.image ? new URL(articleData.image, siteUrl).href : ogImageUrl,
        author: {
          '@type': 'Person',
          name: articleData.author,
          jobTitle: 'Lead Developer, Chwezi Core Systems',
          knowsAbout: ['Property management software', 'SaaS platforms', 'Uganda property operations', 'French and English software delivery'],
        },
        publisher: {
          '@type': 'Organization',
          name: 'AQAR Property Management',
          logo: {
            '@type': 'ImageObject',
            url: `${siteUrl}/favicon.svg`,
          },
        },
        datePublished: articleData.date,
        dateModified: articleData.dateModified || articleData.date,
        mainEntityOfPage: canonicalUrl,
        inLanguage: locale,
      })} />
    )}

    {pageKey !== '' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: lang === 'en' ? 'Home' : 'Accueil',
            item: new URL(`/${lang}/`, siteUrl).href,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: title.split(' | ')[0].split(' - ')[0],
            item: canonicalUrl,
          },
        ],
      })} />
    )}

    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="bg-surface text-neutral-800 font-body min-h-screen flex flex-col">
    <Header lang={lang} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import Alpine from 'alpinejs';
      window.Alpine = Alpine;
      Alpine.start();
    </script>

  </body>
</html>
