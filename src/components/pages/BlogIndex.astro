---
import type { Language } from '../../utils/i18n';
import { getLocalizedPath } from '../../utils/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { Image } from 'astro:assets';

import heroBg from '../../assets/images/AQAR-PROPERTY-03.jpg';
import blogImg1 from '../../assets/images/AQAR-PROPERTY-10.jpg';
import blogImg2 from '../../assets/images/AQAR-PROPERTY-11.jpg';
import blogImg3 from '../../assets/images/AQAR-PROPERTY-12.jpg';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const content = {
  en: {
    title: 'Blog | Property Management Insights | AQAR',
    description: 'Practical property management guides for landlords and property managers: management companies, rental marketing, agreements, rent operations, reporting, and tenant workflows.',
    heroTitle: 'Property Management Operations Guides',
    heroSubtitle: 'Practical articles for landlords and managers who want better collections, cleaner records, and stronger tenant operations.',
    readMore: 'Read More',
    posts: [
      {
        slug: 'choosing-property-management-company',
        title: 'How to Find a Property Management Company That Protects Your Returns',
        excerpt: 'A due diligence framework for evaluating operations, reporting, software discipline, contracts, data handover, and red flags before you appoint a manager.',
        date: '21 May 2025',
        image: blogImg1,
      },
      {
        slug: 'marketing-rental-properties',
        title: 'Marketing Your Rentals to Get Good Tenants',
        excerpt: 'Prepare the unit, write a stronger advert, combine local referrals with digital channels, track lead sources, and protect tenant quality.',
        date: '21 May 2025',
        image: blogImg2,
      },
      {
        slug: 'property-management-agreement',
        title: 'Setting Terms: The Property Management Agreement',
        excerpt: 'A clear agreement protects rental income by defining authority, fees, maintenance approvals, reporting, data handover, termination, and compliance.',
        date: '22 May 2025',
        image: blogImg3,
      },
    ],
  },
  fr: {
    title: 'Blog | Conseils en Gestion Immobili\u00e8re | AQAR',
    description: 'Guides pratiques de gestion immobiliere pour proprietaires et gestionnaires : societes de gestion, marketing locatif, contrats, loyers, rapports et workflows locataires.',
    heroTitle: 'Guides d Operations de Gestion Immobiliere',
    heroSubtitle: 'Articles pratiques pour ameliorer les encaissements, les dossiers, les rapports et le service locataire.',
    readMore: 'Lire la Suite',
    posts: [
      {
        slug: 'choisir-societe-gestion-immobiliere',
        title: 'Choisir la Bonne Soci\u00e9t\u00e9 de Gestion Immobili\u00e8re pour Vos Propri\u00e9t\u00e9s',
        excerpt: 'Un cadre de diligence raisonnable pour evaluer operations, rapports, logiciel, contrats, donnees et signaux d alerte avant de nommer un gestionnaire.',
        date: '21 mai 2025',
        image: blogImg1,
      },
      {
        slug: 'commercialiser-proprietes-locatives',
        title: 'Commercialiser Vos Locations pour Trouver de Bons Locataires',
        excerpt: 'Preparez le bien, redigez une annonce plus forte, combinez reseaux locaux et canaux digitaux, suivez les prospects et protegez la qualite des locataires.',
        date: '21 mai 2025',
        image: blogImg2,
      },
      {
        slug: 'contrat-gestion-immobiliere',
        title: 'Fixer les Conditions : Le Contrat de Gestion Immobili\u00e8re',
        excerpt: 'Un contrat clair protege les revenus locatifs en definissant autorite, frais, maintenance, rapports, donnees, resiliation et conformite.',
        date: '22 mai 2025',
        image: blogImg3,
      },
    ],
  },
};

const t = content[lang];
---

<BaseLayout lang={lang} title={t.title} description={t.description} pageKey="blog">
  <!-- Hero -->
  <Hero lang={lang} title={t.heroTitle} subtitle={t.heroSubtitle} bgImage={heroBg} />

  <!-- Blog Cards -->
  <section class="bg-surface py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {t.posts.map((post, i) => (
          <article class={`animate-on-scroll stagger-${i + 1} group rounded-xl bg-white border border-neutral-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300`}>
            <a href={`/${lang}/blog/${post.slug}/`} class="block">
              <div class="aspect-[16/10] overflow-hidden">
                <Image
                  src={post.image}
                  alt={post.title}
                  class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                  widths={[400, 600]}
                  sizes="(max-width: 768px) 90vw, (max-width: 1024px) 45vw, 30vw"
                />
              </div>
              <div class="p-6">
                <time class="text-xs font-semibold text-primary-600 uppercase tracking-wider">{post.date}</time>
                <h2 class="mt-2 font-display text-xl font-bold text-charcoal leading-snug group-hover:text-primary-700 transition-colors duration-200">
                  {post.title}
                </h2>
                <p class="mt-3 text-sm text-neutral-600 leading-relaxed line-clamp-3">
                  {post.excerpt}
                </p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 group-hover:text-primary-800 transition-colors duration-200">
                  {t.readMore}
                  <svg class="h-4 w-4 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
