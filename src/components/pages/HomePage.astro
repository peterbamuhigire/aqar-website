---
import type { Language } from '../../utils/i18n';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../CtaBanner.astro';
import Lightbox from '../Lightbox.astro';
import {
  ArrowRight,
  BadgeCheck,
  Building2,
  ClipboardCheck,
  FileText,
  Landmark,
  LockKeyhole,
  MessageSquareText,
  ReceiptText,
  ShieldCheck,
  Smartphone,
  Wrench,
} from 'lucide-astro';

import heroBg from '../../assets/images/AQAR-PROPERTY-01.jpg';
import propertyQuarter from '../../assets/images/PHOTO-BANK-APARTMENT-QUARTER.jpg';
import cityscape from '../../assets/images/PHOTO-BANK-CITYSCAPE.jpg';
import screenshotProperties from '../../assets/images/SCREENSHOT-PROPERTIES-LIST.jpg';
import screenshotRent from '../../assets/images/SCREENSHOT-RENT-PAYMENT.jpg';
import screenshotVacant from '../../assets/images/SCREENSHOT-VACANT-UNITS.jpg';
import screenshotMaintenance from '../../assets/images/SCREENSHOT-MAINTENANCE-REPORT.jpg';
import screenshotRemittance from '../../assets/images/SCREENSHOT-MONTHLY-REPORT-REMMITANCE-DETAILS-FOR-LANDLORD-WITH-COMMISION-DUE-TO-COMPANY.jpg';
import screenshotRoles from '../../assets/images/SCREENSHOT-PERMISSIONS-ROLES-MANAGEMENT-RBAC.jpg';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const content = {
  en: {
    title: 'Property Management Software Uganda | AQAR Rent Operations Platform',
    description: 'AQAR is Uganda-first property management software for serious landlords and property management firms. Manage rent, tenants, invoices, payment proof, maintenance, landlord reports, remittances, documents, and audit-ready workflows.',
    eyebrow: 'Property management software for Uganda and East Africa',
    heroTitle: 'Replace Excel and WhatsApp with a serious rent operations system.',
    heroSubtitle: 'AQAR helps property managers, portfolio landlords, accountants, and tenants run rent collection, payment proof, leases, maintenance, inspections, remittances, and landlord reporting from one cloud platform.',
    primaryCta: 'Open live demo',
    secondaryCta: 'Discuss your portfolio',
    demoNote: 'No installation. Browser-based demo with real product screens.',
    proof: [
      { value: '78+', label: 'property management clients served' },
      { value: '2018', label: 'software delivery experience behind the product' },
      { value: 'UG-first', label: 'built around Kampala rent operations and local workflows' },
      { value: 'EN + FR', label: 'bilingual product and support capability' },
    ],
    answerTitle: 'What is AQAR?',
    answer: 'AQAR is cloud property management software for rental operations. It gives property managers and landlords a structured system for properties, units, tenants, leases, rent invoices, payment proof verification, receipts, maintenance requests, inspections, landlord remittance statements, documents, and role-based access.',
    painTitle: 'Why property managers outgrow spreadsheets',
    pains: [
      'Payment screenshots arrive through WhatsApp and staff still have to match them to tenants, units, and invoices.',
      'Landlord reports take too long to prepare, which creates follow-up calls, trust issues, and repeated explanations.',
      'Maintenance requests, inspection photos, lease files, and receipts get scattered across phones, paper folders, and email threads.',
      'Managers need to know what needs action today, not just browse another table of records.',
    ],
    systemTitle: 'The operating system for rent collection and landlord confidence',
    systemIntro: 'Aqar is designed to remove operational work, not merely store data. The platform turns rent collection, reporting, tenant service, maintenance, and compliance evidence into traceable workflows.',
    modules: [
      { title: 'Command centre', desc: 'Portfolio health, occupancy, arrears, lease expiries, unverified payments, maintenance queues, and manager actions in one dashboard.', icon: Building2 },
      { title: 'Rent and payments', desc: 'Generate invoices, record payments, verify tenant proof, issue receipts, track arrears, and keep balances explainable.', icon: ReceiptText },
      { title: 'Landlord remittances', desc: 'Close periods with commissions, deductions, landlord statements, remittance status, and downloadable financial outputs.', icon: Landmark },
      { title: 'Maintenance and inspections', desc: 'Capture requests, photos, assignments, costs, status changes, inspection checklists, and evidence-backed reports.', icon: Wrench },
      { title: 'Documents and notices', desc: 'Keep leases, receipts, statements, inspection documents, notices, and entity-linked files controlled and searchable.', icon: FileText },
      { title: 'Roles and audit trails', desc: 'Use role-based access, company isolation, support controls, and activity history for sensitive financial and tenant actions.', icon: ShieldCheck },
    ],
    workflowsTitle: 'Built around the work your team repeats every month',
    workflows: [
      { step: '01', title: 'Set up the portfolio', desc: 'Import properties, units, landlords, tenants, leases, rent amounts, deposits, documents, and opening balances.' },
      { step: '02', title: 'Run monthly billing', desc: 'Generate rent invoices, send approved reminders, track unpaid balances, and keep communication tied to each tenancy.' },
      { step: '03', title: 'Verify collections', desc: 'Move payment proof from chat chaos into a review queue where accountants can verify, reject, receipt, and allocate.' },
      { step: '04', title: 'Report and remit', desc: 'Produce landlord statements, remittance summaries, deductions, arrears views, maintenance costs, and clear downloadable reports.' },
    ],
    proofTitle: 'Product proof, not brochure promises',
    proofIntro: 'The website keeps the software visible because serious buyers need to inspect the operational surface before they trust the claim.',
    screenshotCards: [
      { title: 'Portfolio dashboard', desc: 'Properties, occupancy, status, and portfolio visibility for managers.', image: screenshotProperties },
      { title: 'Rent payment records', desc: 'Track rent payments, references, balances, and collection activity.', image: screenshotRent },
      { title: 'Vacancy control', desc: 'Know which units are vacant, occupied, due, or needing action.', image: screenshotVacant },
      { title: 'Maintenance reports', desc: 'Review requests, costs, status, and maintenance evidence.', image: screenshotMaintenance },
    ],
    complianceTitle: 'Uganda-first compliance posture',
    complianceIntro: 'Aqar is designed for DPPA-aware operation and strict tenant-data boundaries. We avoid unsupported public claims such as automated URA filing, NIRA verification, or DPPA compliance until the required legal and production approvals are complete.',
    compliance: [
      { title: 'Company isolation', desc: 'Operational data belongs to the subscriber company. Cross-company tenant rental history is not exposed.' },
      { title: 'Global tenant identity boundary', desc: 'Tenant identity can reduce duplicate records while keeping tenancy-specific data private.' },
      { title: 'Auditable sensitive actions', desc: 'Payments, remittances, role changes, document access, identity linking, and support activity need a traceable record.' },
      { title: 'DPPA-aware workflows', desc: 'The product model accounts for notices, data subject requests, retention decisions, breach handling, and DPO review.' },
    ],
    fitTitle: 'Who AQAR is for',
    fit: [
      'Property management firms that need consistent reporting across many landlords and units.',
      'Portfolio landlords who want visibility without depending on weekly phone calls.',
      'Accountants who need receipts, balances, verification queues, remittances, and audit trails.',
      'Tenants who need balances, receipts, maintenance requests, notices, and documents in one place.',
    ],
    limitsTitle: 'MVP scope stated clearly',
    limitsIntro: 'The current MVP focuses on the web-based property management system. Mobile apps, direct MTN MoMo/Airtel Money integrations, NIRA verification, automated URA filing, tenant blacklisting, and digital lease signatures are not presented as live MVP features.',
    faqTitle: 'Property management software questions',
    faqs: [
      { q: 'Is AQAR a property listing marketplace?', a: 'No. AQAR is not positioned as a real estate marketplace. It is property management software for rent operations after properties, landlords, units, tenants, and leases already need to be managed.' },
      { q: 'Can AQAR replace Excel for property managers?', a: 'Yes, that is the main operational goal. Aqar replaces scattered sheets with workflow queues, tenant records, rent invoices, payment proof verification, receipts, landlord reports, remittances, maintenance records, documents, and audit history.' },
      { q: 'Does AQAR support mobile money payments?', a: 'The MVP supports manual payment recording and proof verification. Direct MTN MoMo and Airtel Money payment integrations should only be claimed after provider approval, reconciliation, reversal handling, idempotency, and audit testing are complete.' },
      { q: 'Is AQAR DPPA compliant?', a: 'The careful claim is DPPA-aware by design. Production compliance depends on approved lawful basis, notice or consent model, controller/processor roles, retention, DSR, DPO, breach, and DPIA decisions.' },
      { q: 'Can I try AQAR without installing software?', a: 'Yes. AQAR is browser-based, and the live demo can be opened without local installation.' },
    ],
  },
  fr: {
    title: 'Logiciel de gestion immobiliere Uganda | AQAR',
    description: 'AQAR est un logiciel de gestion immobiliere concu pour les proprietaires serieux et les societes de gestion immobiliere. Gere les loyers, locataires, factures, preuves de paiement, maintenance, rapports proprietaires, versements, documents et workflows auditables.',
    eyebrow: 'Logiciel de gestion immobiliere pour l Ouganda et l Afrique de l Est',
    heroTitle: 'Remplacez Excel et WhatsApp par un vrai systeme d operations locatives.',
    heroSubtitle: 'AQAR aide les gestionnaires immobiliers, proprietaires de portefeuille, comptables et locataires a gerer loyers, preuves de paiement, baux, maintenance, inspections, versements et rapports proprietaires depuis une plateforme cloud.',
    primaryCta: 'Ouvrir la demo',
    secondaryCta: 'Parler de votre portefeuille',
    demoNote: 'Aucune installation. Demo web avec de vrais ecrans produit.',
    proof: [
      { value: '78+', label: 'clients de gestion immobiliere servis' },
      { value: '2018', label: 'experience logicielle derriere le produit' },
      { value: 'UG-first', label: 'pense pour les operations locatives de Kampala' },
      { value: 'EN + FR', label: 'capacite produit et support bilingue' },
    ],
    answerTitle: 'Qu est-ce qu AQAR ?',
    answer: 'AQAR est un logiciel cloud de gestion immobiliere pour les operations locatives. Il donne aux gestionnaires et proprietaires un systeme structure pour biens, unites, locataires, baux, factures de loyer, verification des preuves de paiement, recus, maintenance, inspections, versements aux proprietaires, documents et acces par role.',
    painTitle: 'Pourquoi les gestionnaires depassent les tableurs',
    pains: [
      'Les captures de paiement arrivent sur WhatsApp et l equipe doit encore les associer aux locataires, unites et factures.',
      'Les rapports proprietaires prennent trop de temps et provoquent appels de suivi, doutes et explications repetees.',
      'Demandes de maintenance, photos d inspection, baux et recus se dispersent entre telephones, dossiers papier et e-mails.',
      'Les gestionnaires doivent savoir quoi traiter aujourd hui, pas seulement consulter une autre table de donnees.',
    ],
    systemTitle: 'Le systeme d exploitation de la collecte des loyers et de la confiance proprietaire',
    systemIntro: 'Aqar est concu pour retirer du travail operationnel, pas seulement stocker des donnees. La plateforme transforme collecte, reporting, service locataire, maintenance et preuve de conformite en workflows tracables.',
    modules: [
      { title: 'Centre de commande', desc: 'Sante du portefeuille, occupation, arrieres, expirations de bail, paiements non verifies, maintenance et actions du gestionnaire.', icon: Building2 },
      { title: 'Loyers et paiements', desc: 'Generez factures, enregistrez paiements, verifiez les preuves, emettez recus et gardez des soldes explicables.', icon: ReceiptText },
      { title: 'Versements proprietaires', desc: 'Cloturez les periodes avec commissions, deductions, releves proprietaires, statut de versement et sorties financieres.', icon: Landmark },
      { title: 'Maintenance et inspections', desc: 'Capturez demandes, photos, affectations, couts, statuts, checklists et rapports appuyes par des preuves.', icon: Wrench },
      { title: 'Documents et avis', desc: 'Gardez baux, recus, releves, rapports d inspection, avis et fichiers lies aux entites sous controle.', icon: FileText },
      { title: 'Roles et audits', desc: 'Utilisez acces par role, isolation par societe, controles support et historique pour les actions sensibles.', icon: ShieldCheck },
    ],
    workflowsTitle: 'Concu autour du travail repete chaque mois',
    workflows: [
      { step: '01', title: 'Configurer le portefeuille', desc: 'Importer biens, unites, proprietaires, locataires, baux, loyers, cautions, documents et soldes initiaux.' },
      { step: '02', title: 'Lancer la facturation', desc: 'Generer factures, envoyer rappels approuves, suivre soldes impayes et rattacher la communication au bail.' },
      { step: '03', title: 'Verifier les encaissements', desc: 'Sortir les preuves de paiement des discussions et les placer dans une file de verification comptable.' },
      { step: '04', title: 'Reporter et verser', desc: 'Produire releves proprietaires, resumes de versement, deductions, arrieres, couts maintenance et rapports telechargeables.' },
    ],
    proofTitle: 'Des preuves produit, pas des promesses de brochure',
    proofIntro: 'Le site garde le logiciel visible parce que les acheteurs serieux doivent inspecter l interface operationnelle avant de faire confiance.',
    screenshotCards: [
      { title: 'Tableau de bord portefeuille', desc: 'Biens, occupation, statut et visibilite pour les gestionnaires.', image: screenshotProperties },
      { title: 'Paiements de loyer', desc: 'Suivez paiements, references, soldes et activite de collecte.', image: screenshotRent },
      { title: 'Controle des vacances', desc: 'Identifiez les unites vacantes, occupees, dues ou a traiter.', image: screenshotVacant },
      { title: 'Rapports maintenance', desc: 'Consultez demandes, couts, statuts et preuves de maintenance.', image: screenshotMaintenance },
    ],
    complianceTitle: 'Posture de conformite pensee pour l Ouganda',
    complianceIntro: 'Aqar est concu pour une exploitation sensible a la DPPA et des limites strictes sur les donnees locataires. Nous evitons les affirmations non verifiees comme depot URA automatise, verification NIRA ou conformite DPPA certifiee.',
    compliance: [
      { title: 'Isolation par societe', desc: 'Les donnees operationnelles appartiennent a la societe abonne. L historique locatif inter-societes n est pas expose.' },
      { title: 'Limite identite locataire', desc: 'L identite globale peut reduire les doublons tout en gardant privees les donnees propres a chaque bail.' },
      { title: 'Actions sensibles auditables', desc: 'Paiements, versements, roles, documents, liaison identite et support doivent laisser une trace.' },
      { title: 'Workflows DPPA-aware', desc: 'Le modele prevoit avis, demandes de droits, retention, violation de donnees et revue DPO.' },
    ],
    fitTitle: 'Pour qui AQAR est fait',
    fit: [
      'Societes de gestion qui veulent un reporting coherent entre plusieurs proprietaires et unites.',
      'Proprietaires de portefeuille qui veulent de la visibilite sans appels hebdomadaires.',
      'Comptables qui ont besoin de recus, soldes, verification, versements et audit.',
      'Locataires qui veulent soldes, recus, maintenance, avis et documents au meme endroit.',
    ],
    limitsTitle: 'Perimetre MVP clair',
    limitsIntro: 'Le MVP actuel se concentre sur le systeme web de gestion immobiliere. Les applications mobiles, integrations directes MTN MoMo/Airtel Money, verification NIRA, depot URA automatise, liste noire locataire et signature numerique des baux ne sont pas presentes comme fonctionnalites MVP en production.',
    faqTitle: 'Questions sur le logiciel de gestion immobiliere',
    faqs: [
      { q: 'AQAR est-il une place de marche immobiliere ?', a: 'Non. AQAR n est pas positionne comme un portail d annonces. C est un logiciel de gestion immobiliere pour les operations locatives apres qu il faut gerer biens, proprietaires, unites, locataires et baux.' },
      { q: 'AQAR peut-il remplacer Excel ?', a: 'Oui, c est l objectif operationnel central. Aqar remplace les feuilles dispersees par des files de travail, dossiers locataires, factures, verification de paiement, recus, rapports, versements, maintenance, documents et historique.' },
      { q: 'AQAR gere-t-il les paiements mobile money ?', a: 'Le MVP gere l enregistrement manuel et la verification des preuves de paiement. Les integrations directes MTN MoMo et Airtel Money ne doivent etre revendiquees qu apres approbation fournisseur et tests complets.' },
      { q: 'AQAR est-il conforme DPPA ?', a: 'L affirmation prudente est DPPA-aware by design. La conformite production depend de decisions approuvees sur base legale, avis ou consentement, roles, retention, DSR, DPO, breach et DPIA.' },
      { q: 'Puis-je essayer AQAR sans installation ?', a: 'Oui. AQAR est base sur navigateur et la demo en ligne peut etre ouverte sans installation locale.' },
    ],
  },
};

const c = content[lang];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<BaseLayout lang={lang} title={c.title} description={c.description} pageKey="" extraSchemas={[faqSchema]}>
  <Lightbox />

  <section class="relative overflow-hidden bg-charcoal">
    <Image src={heroBg} alt="" loading="eager" class="absolute inset-0 h-full w-full object-cover opacity-35" widths={[640, 1024, 1536, 2048]} sizes="100vw" />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/88 to-charcoal/55"></div>
    <div class="relative mx-auto grid min-h-[calc(100vh-4rem)] max-w-7xl grid-cols-1 items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_0.92fr] lg:px-8">
      <div class="max-w-3xl">
        <p class="animate-on-scroll text-sm font-bold uppercase tracking-[0.18em] text-secondary-400">{c.eyebrow}</p>
        <h1 class="animate-on-scroll stagger-1 mt-5 font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
          {c.heroTitle}
        </h1>
        <p class="animate-on-scroll stagger-2 mt-6 max-w-2xl text-lg leading-relaxed text-neutral-200 sm:text-xl">
          {c.heroSubtitle}
        </p>
        <div class="animate-on-scroll stagger-3 mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="https://property.chwezi.co.za" target="_blank" rel="noopener noreferrer" class="btn inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg bg-secondary-500 px-7 py-3.5 text-base font-bold text-white hover:bg-secondary-600">
            {c.primaryCta}
            <ArrowRight class="h-5 w-5" />
          </a>
          <a href="https://wa.me/256784464178" target="_blank" rel="noopener noreferrer" class="btn inline-flex min-h-[48px] items-center justify-center rounded-lg border border-white/25 bg-white/10 px-7 py-3.5 text-base font-bold text-white hover:bg-white/15">
            {c.secondaryCta}
          </a>
        </div>
        <p class="animate-on-scroll stagger-4 mt-4 text-sm text-neutral-300">{c.demoNote}</p>
      </div>

      <div class="animate-on-scroll stagger-2">
        <div class="relative mx-auto max-w-2xl">
          <div class="absolute -left-5 -top-5 hidden rounded-lg bg-white p-4 shadow-xl sm:block">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-md bg-success-50 text-success-700"><BadgeCheck class="h-5 w-5" /></div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">Operational proof</p>
                <p class="font-display text-lg font-extrabold text-charcoal">Live dashboards</p>
              </div>
            </div>
          </div>
          <div class="rounded-xl bg-neutral-900 p-2 shadow-2xl">
            <div class="flex items-center gap-1.5 rounded-t-lg bg-neutral-800 px-3 py-2">
              <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
              <span class="ml-3 text-xs text-neutral-400">property.chwezi.co.za</span>
            </div>
            <Image src={screenshotProperties} alt="AQAR property management dashboard showing managed properties" class="rounded-b-lg" widths={[640, 1024, 1536]} sizes="(max-width: 1024px) 92vw, 560px" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-10">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px overflow-hidden rounded-lg border border-neutral-200 bg-neutral-200 px-0 sm:grid-cols-4">
      {c.proof.map((item) => (
        <div class="bg-white p-5 sm:p-6">
          <p class="font-display text-3xl font-extrabold text-primary-700">{item.value}</p>
          <p class="mt-1 text-sm leading-snug text-neutral-600">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-surface py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
      <div>
        <h2 class="animate-on-scroll font-display text-3xl font-extrabold text-charcoal sm:text-4xl">{c.answerTitle}</h2>
        <p class="animate-on-scroll stagger-1 mt-5 text-lg leading-relaxed text-neutral-700">{c.answer}</p>
        <div class="animate-on-scroll stagger-2 mt-8 overflow-hidden rounded-lg">
          <Image src={cityscape} alt="Modern apartment buildings representing managed rental portfolios" class="h-72 w-full object-cover" widths={[480, 760, 1024]} sizes="(max-width: 1024px) 100vw, 420px" />
        </div>
      </div>
      <div>
        <h2 class="animate-on-scroll font-display text-3xl font-extrabold text-charcoal sm:text-4xl">{c.painTitle}</h2>
        <div class="mt-6 grid grid-cols-1 gap-4">
          {c.pains.map((pain, i) => (
            <div class={`animate-on-scroll stagger-${(i % 4) + 1} flex gap-4 rounded-lg border border-neutral-200 bg-white p-5 shadow-sm`}>
              <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-secondary-50 text-secondary-700">
                <ClipboardCheck class="h-4 w-4" />
              </div>
              <p class="leading-relaxed text-neutral-700">{pain}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="animate-on-scroll font-display text-3xl font-extrabold text-white sm:text-4xl">{c.systemTitle}</h2>
        <p class="animate-on-scroll stagger-1 mt-4 text-lg leading-relaxed text-neutral-300">{c.systemIntro}</p>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {c.modules.map((module, i) => {
          const Icon = module.icon;
          return (
            <article class={`animate-on-scroll stagger-${(i % 5) + 1} rounded-lg border border-white/10 bg-white/[0.04] p-6`}>
              <div class="flex h-11 w-11 items-center justify-center rounded-md bg-primary-500/15 text-primary-300">
                <Icon class="h-5 w-5" />
              </div>
              <h3 class="mt-5 font-display text-xl font-bold text-white">{module.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-300">{module.desc}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-8">
      <div>
        <h2 class="animate-on-scroll font-display text-3xl font-extrabold text-charcoal sm:text-4xl">{c.workflowsTitle}</h2>
        <div class="animate-on-scroll stagger-1 mt-8 overflow-hidden rounded-lg">
          <Image src={propertyQuarter} alt="Managed apartment quarter for rental property operations" class="h-80 w-full object-cover" widths={[480, 760, 1024]} sizes="(max-width: 1024px) 100vw, 420px" />
        </div>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {c.workflows.map((item, i) => (
          <article class={`animate-on-scroll stagger-${(i % 4) + 1} grid grid-cols-[4rem_1fr] gap-5 rounded-lg border border-neutral-200 bg-surface p-5`}>
            <div class="font-display text-2xl font-extrabold text-primary-700">{item.step}</div>
            <div>
              <h3 class="font-display text-lg font-bold text-charcoal">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-neutral-700">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="animate-on-scroll font-display text-3xl font-extrabold text-charcoal sm:text-4xl">{c.proofTitle}</h2>
        <p class="animate-on-scroll stagger-1 mt-4 text-lg leading-relaxed text-neutral-700">{c.proofIntro}</p>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {c.screenshotCards.map((card, i) => (
          <article class={`animate-on-scroll stagger-${(i % 4) + 1} overflow-hidden rounded-lg border border-neutral-200 bg-white shadow-sm`}>
            <div class="bg-neutral-900 p-2">
              <div class="flex items-center gap-1.5 rounded-t-md bg-neutral-800 px-3 py-2">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
              </div>
              <Image src={card.image} alt={card.title} class="h-64 w-full rounded-b-md object-cover object-top" widths={[480, 760, 1024]} sizes="(max-width: 768px) 100vw, 50vw" />
            </div>
            <div class="p-5">
              <h3 class="font-display text-lg font-bold text-charcoal">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">{card.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <div class="flex h-12 w-12 items-center justify-center rounded-md bg-success-500/15 text-success-300">
          <LockKeyhole class="h-6 w-6" />
        </div>
        <h2 class="mt-6 font-display text-3xl font-extrabold text-white sm:text-4xl">{c.complianceTitle}</h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-300">{c.complianceIntro}</p>
        <div class="mt-8 rounded-lg bg-white/[0.04] p-5">
          <Image src={screenshotRoles} alt="AQAR role-based access management screen" class="rounded-md" widths={[480, 760]} sizes="(max-width: 1024px) 100vw, 520px" />
        </div>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {c.compliance.map((item, i) => (
          <article class={`animate-on-scroll stagger-${(i % 4) + 1} rounded-lg border border-white/10 bg-white/[0.04] p-6`}>
            <div class="flex items-start gap-4">
              <ShieldCheck class="mt-1 h-5 w-5 shrink-0 text-success-300" />
              <div>
                <h3 class="font-display text-lg font-bold text-white">{item.title}</h3>
                <p class="mt-2 leading-relaxed text-neutral-300">{item.desc}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <h2 class="font-display text-3xl font-extrabold text-charcoal sm:text-4xl">{c.fitTitle}</h2>
        <ul class="mt-7 space-y-4">
          {c.fit.map((item) => (
            <li class="flex gap-3 text-lg leading-relaxed text-neutral-700">
              <BadgeCheck class="mt-1 h-5 w-5 shrink-0 text-primary-600" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-lg border border-neutral-200 bg-surface p-7">
        <div class="flex h-12 w-12 items-center justify-center rounded-md bg-primary-50 text-primary-700">
          <Smartphone class="h-6 w-6" />
        </div>
        <h2 class="mt-6 font-display text-2xl font-extrabold text-charcoal">{c.limitsTitle}</h2>
        <p class="mt-4 leading-relaxed text-neutral-700">{c.limitsIntro}</p>
      </div>
    </div>
  </section>

  <section class="bg-surface py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-extrabold text-charcoal sm:text-4xl">{c.faqTitle}</h2>
      <div class="mt-8 space-y-4" x-data="{ active: 0 }">
        {c.faqs.map((faq, i) => (
          <div class="rounded-lg border border-neutral-200 bg-white shadow-sm">
            <button class="flex min-h-[56px] w-full items-center justify-between gap-4 px-5 py-4 text-left font-display font-bold text-charcoal" @click={`active = active === ${i} ? null : ${i}`} :aria-expanded={`active === ${i}`}>
              <span>{faq.q}</span>
              <MessageSquareText class="h-5 w-5 shrink-0 text-primary-600" />
            </button>
            <div x-show={`active === ${i}`} x-cloak>
              <p class="px-5 pb-5 leading-relaxed text-neutral-700">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner lang={lang} />
</BaseLayout>
