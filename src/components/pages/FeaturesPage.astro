---
import type { Language } from '../../utils/i18n';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../CtaBanner.astro';
import Lightbox from '../Lightbox.astro';
import {
  Building2,
  Database,
  FileSpreadsheet,
  FileText,
  LockKeyhole,
  MapPinned,
  ReceiptText,
  ShieldCheck,
  UsersRound,
  Wrench,
} from 'lucide-astro';

import heroBg from '../../assets/images/AQAR-PROPERTY-05.jpg';
import screenshotDashboard from '../../assets/images/SCREENSHOT-PROPERTIES-LIST.jpg';
import screenshotRent from '../../assets/images/SCREENSHOT-RENT-PAYMENT.jpg';
import screenshotRemittance from '../../assets/images/SCREENSHOT-MONTHLY-REPORT-REMMITANCE-DETAILS-FOR-LANDLORD-WITH-COMMISION-DUE-TO-COMPANY.jpg';
import screenshotMaintenance from '../../assets/images/SCREENSHOT-ADD-MAINTENANCE-RECORD.jpg';
import screenshotInspection from '../../assets/images/SCREENSHOT-INSPECTION-TEMPLATES.jpg';
import screenshotDocuments from '../../assets/images/SCREENSHOT-LEASE-EXPIRY-REPORT.jpg';
import screenshotRoles from '../../assets/images/SCREENSHOT-PERMISSIONS-ROLES-MANAGEMENT-RBAC.jpg';
import screenshotGps from '../../assets/images/SCREENSHOT-GPS-REPORTS.jpg';
import screenshotLandlords from '../../assets/images/SCREENSHOT-LANDLORDS-LIST.jpg';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const content = {
  en: {
    title: 'AQAR Platform Features | Rent Collection, Tenants, Maintenance, Reports',
    description: 'Explore AQAR property management software features: portfolio dashboard, tenant identity, leases, rent invoicing, payment proof verification, receipts, landlord remittances, maintenance, inspections, documents, communications, RBAC, audit trails, and Excel import/export.',
    heroTitle: 'A property management platform built around real rent operations',
    heroSubtitle: 'Aqar gives every role a clear workspace: managers see action queues, accountants verify collections, landlords view reports, and tenants access their records.',
    directTitle: 'What does AQAR include?',
    directAnswer: 'AQAR includes the core web workflows required to operate rental property portfolios: properties, units, tenants, leases, invoices, manual payments, payment proof verification, receipts, maintenance, inspections, landlord statements, remittances, documents, announcements, access control, audit trails, and Excel import/export.',
    sections: [
      {
        title: 'Dashboard and portfolio command centre',
        desc: 'Start each day with occupancy, vacancies, arrears, lease expiries, unverified payments, maintenance, and portfolio health instead of searching through spreadsheets.',
        bullets: ['Role-specific dashboards for managers, accountants, and landlords', 'Property, unit, occupancy, vacancy, and assignment views', 'Action queues for overdue payments, expiring leases, and unresolved work', 'Portfolio ranking by value, occupancy, collections, and operating status'],
        image: screenshotDashboard,
        icon: Building2,
      },
      {
        title: 'Tenant identity, leases, and records',
        desc: 'Keep tenant identity, tenancy history, lease terms, deposits, documents, and notes in one controlled place while respecting privacy boundaries.',
        bullets: ['Tenant profiles linked to units and leases', 'Lease start, end, renewal, deposit, billing day, and notice details', 'Expiry alerts for renewal and follow-up', 'Global tenant identity model with biography-only boundaries'],
        image: screenshotLandlords,
        icon: UsersRound,
      },
      {
        title: 'Rent invoicing and payment proof verification',
        desc: 'Move collections from screenshots and informal messages into invoices, proof review, receipts, balances, and arrears workflows.',
        bullets: ['Rent invoices and payment records', 'Manual payment capture for payment-proof operations', 'Proof verification and rejection workflow', 'Receipts, tenant balances, arrears, and partial payment tracking'],
        image: screenshotRent,
        icon: ReceiptText,
      },
      {
        title: 'Period close and landlord remittance statements',
        desc: 'Give landlords credible reports that explain rent received, commissions, deductions, maintenance costs, remittances, and balances.',
        bullets: ['Monthly close workflow', 'Management fee and deduction handling', 'Landlord remittance statements and paid status', 'Downloadable reports that reduce repeated landlord calls'],
        image: screenshotRemittance,
        icon: FileSpreadsheet,
      },
      {
        title: 'Maintenance and inspection evidence',
        desc: 'Turn maintenance requests, costs, photos, assignments, inspection checklists, and follow-up into traceable operational records.',
        bullets: ['Maintenance request logging and assignment', 'Status tracking from reported to resolved', 'Cost capture per property and unit', 'Inspection templates, photo evidence, and report outputs'],
        image: screenshotMaintenance,
        icon: Wrench,
      },
      {
        title: 'Documents, notices, and communications',
        desc: 'Keep lease files, invoices, receipts, statements, notices, and tenant-facing documents attached to the right entity instead of scattered across phones and folders.',
        bullets: ['Entity-linked document storage', 'Lease expiry, reports, receipts, and statements', 'Announcements, reminders, SMS/email/push-ready event model', 'Communication records tied to the tenancy context'],
        image: screenshotDocuments,
        icon: FileText,
      },
      {
        title: 'Security, roles, and audit trail',
        desc: 'Protect sensitive property, tenant, payment, and landlord data with role-aware access and traceable actions.',
        bullets: ['Role-based access control for staff and stakeholders', 'Company isolation for operational data', 'Support access designed to be approved and auditable', 'Audit trails for sensitive financial, document, and identity actions'],
        image: screenshotRoles,
        icon: LockKeyhole,
      },
      {
        title: 'GIS, reports, and country configuration',
        desc: 'Support location-aware property management and keep regional requirements organized through clear payment, tax, identity, currency, and communication settings.',
        bullets: ['GPS and location reports', 'Exports for operational review', 'Uganda-first workflows for rent operations', 'Configuration points for payment, tax, identity, currency, and communication differences'],
        image: screenshotGps,
        icon: MapPinned,
      },
    ],
    comparisonTitle: 'AQAR compared with spreadsheet property management',
    comparison: [
      ['Rent collection', 'Manual matching of screenshots and references', 'Invoices, proof review, receipts, arrears, balances, and audit history'],
      ['Landlord reporting', 'Late manual reports assembled from multiple files', 'Period close, remittance statements, deductions, and downloadable outputs'],
      ['Maintenance', 'Phone calls, chat threads, and personal photo galleries', 'Requests, assignments, costs, status, and evidence records'],
      ['Access control', 'Shared files and informal permissions', 'Roles, company isolation, support controls, and sensitive-action logs'],
      ['Tenant service', 'Repeated calls for balances, receipts, and documents', 'Self-service records and structured notices where enabled'],
    ],
    faqTitle: 'Feature questions',
    faqs: [
      { q: 'Does AQAR work for property management companies?', a: 'Yes. Property management firms use AQAR to manage tenant records, collections, landlord reporting, maintenance tracking, remittances, documents, and access control across many owners and units.' },
      { q: 'Can landlords log in to see their reports?', a: 'Yes. Aqar gives landlords portfolio visibility, collections, arrears, vacancies, maintenance costs, remittances, and downloadable reports according to their access permissions.' },
      { q: 'Can tenants submit payment proof?', a: 'Yes. AQAR supports tenant payment proof submission and manager or accountant verification so payment records move through a structured workflow.' },
      { q: 'Does AQAR support Excel import and export?', a: 'Yes. Excel import/export is part of the onboarding and exit workflow so teams can migrate from spreadsheets without losing control of their records.' },
      { q: 'What makes AQAR different from a generic imported PMS?', a: 'AQAR is built around Uganda-first rent operations, payment proof workflows, landlord remittances, SMS-ready communication, DPPA-aware tenant data, and company isolation rather than broad real estate listing workflows.' },
    ],
  },
  fr: {
    title: 'Fonctionnalites AQAR | Loyers, locataires, maintenance, rapports',
    description: 'Decouvrez les fonctionnalites AQAR : tableau de bord, identite locataire, baux, facturation, verification des preuves de paiement, recus, versements proprietaires, maintenance, inspections, documents, communications, roles, audits et import/export Excel.',
    heroTitle: 'Une plateforme de gestion immobiliere construite autour des vraies operations locatives',
    heroSubtitle: 'Aqar donne a chaque role un espace clair : les gestionnaires voient les actions, les comptables verifient les encaissements, les proprietaires consultent les rapports et les locataires accedent a leurs dossiers.',
    directTitle: 'Que comprend AQAR ?',
    directAnswer: 'AQAR comprend les workflows web essentiels pour gerer un portefeuille locatif : biens, unites, locataires, baux, factures, paiements manuels, verification de preuves, recus, maintenance, inspections, releves proprietaires, versements, documents, annonces, controle d acces, audits et import/export Excel.',
    sections: [
      {
        title: 'Tableau de bord et centre de commande',
        desc: 'Commencez la journee avec occupation, vacances, arrieres, expirations de bail, paiements non verifies, maintenance et sante du portefeuille.',
        bullets: ['Tableaux par role pour gestionnaires, comptables et proprietaires', 'Vues biens, unites, occupation, vacances et affectations', 'Files d action pour impayes, baux expirants et travaux ouverts', 'Classement du portefeuille par valeur, occupation, collections et statut'],
        image: screenshotDashboard,
        icon: Building2,
      },
      {
        title: 'Identite locataire, baux et dossiers',
        desc: 'Gardez identite, historique de location, termes de bail, cautions, documents et notes dans un espace controle.',
        bullets: ['Profils locataires lies aux unites et baux', 'Dates, renouvellement, caution, jour de facturation et preavis', 'Alertes d expiration et de renouvellement', 'Identite globale avec limites biographiques uniquement'],
        image: screenshotLandlords,
        icon: UsersRound,
      },
      {
        title: 'Facturation et verification des preuves',
        desc: 'Transformez les collections en factures, preuves a verifier, recus, soldes et workflows d arrieres.',
        bullets: ['Factures de loyer et enregistrements de paiement', 'Capture manuelle des paiements pour les operations de preuve', 'Workflow verification/rejet des preuves', 'Recus, soldes locataires, arrieres et paiements partiels'],
        image: screenshotRent,
        icon: ReceiptText,
      },
      {
        title: 'Cloture et versements proprietaires',
        desc: 'Fournissez des rapports clairs sur loyers recus, commissions, deductions, couts de maintenance, versements et soldes.',
        bullets: ['Workflow de cloture mensuelle', 'Frais de gestion et deductions', 'Releves de versement et statut paye', 'Rapports telechargeables qui reduisent les appels'],
        image: screenshotRemittance,
        icon: FileSpreadsheet,
      },
      {
        title: 'Maintenance et preuves d inspection',
        desc: 'Transformez demandes, couts, photos, affectations et checklists en dossiers operationnels tracables.',
        bullets: ['Enregistrement et affectation des demandes', 'Suivi du statut jusqu a resolution', 'Couts par bien et unite', 'Modeles d inspection, photos et rapports'],
        image: screenshotMaintenance,
        icon: Wrench,
      },
      {
        title: 'Documents, avis et communications',
        desc: 'Gardez baux, factures, recus, releves, avis et documents rattaches a la bonne entite.',
        bullets: ['Stockage documentaire lie aux entites', 'Baux, rapports, recus et releves', 'Annonces et rappels avec modele evenementiel SMS/e-mail/push', 'Communication rattachee au contexte du bail'],
        image: screenshotDocuments,
        icon: FileText,
      },
      {
        title: 'Securite, roles et audit',
        desc: 'Protegez les donnees sensibles avec acces par role et actions tracables.',
        bullets: ['Controle d acces par role', 'Isolation des donnees par societe', 'Acces support approuve et auditable', 'Journaux pour actions financieres, documentaires et identite'],
        image: screenshotRoles,
        icon: LockKeyhole,
      },
      {
        title: 'GIS, rapports et configuration pays',
        desc: 'Soutenez la gestion geolocalisee et gardez les exigences regionales organisees par paiement, taxe, identite, devise et communication.',
        bullets: ['Rapports GPS et localisation', 'Exports operationnels', 'Workflows Uganda-first pour les operations locatives', 'Points de configuration pour paiement, taxe, identite, devise et communication'],
        image: screenshotGps,
        icon: MapPinned,
      },
    ],
    comparisonTitle: 'AQAR compare a la gestion par tableur',
    comparison: [
      ['Collecte des loyers', 'Association manuelle des captures et references', 'Factures, preuves, recus, arrieres, soldes et audit'],
      ['Rapports proprietaires', 'Rapports manuels tardifs depuis plusieurs fichiers', 'Cloture, releves de versement, deductions et exports'],
      ['Maintenance', 'Appels, discussions et photos sur telephones', 'Demandes, affectations, couts, statuts et preuves'],
      ['Controle d acces', 'Fichiers partages et permissions informelles', 'Roles, isolation, controles support et journaux'],
      ['Service locataire', 'Appels repetes pour soldes, recus et documents', 'Dossiers self-service et avis structures selon configuration'],
    ],
    faqTitle: 'Questions sur les fonctionnalites',
    faqs: [
      { q: 'AQAR convient-il aux societes de gestion ?', a: 'Oui. Les societes de gestion utilisent AQAR pour gerer dossiers locataires, collections, rapports proprietaires, maintenance, versements, documents et acces controle sur plusieurs proprietaires et unites.' },
      { q: 'Les proprietaires peuvent-ils consulter leurs rapports ?', a: 'Oui. Aqar donne aux proprietaires la visibilite sur portefeuille, collections, arrieres, vacances, couts de maintenance, versements et rapports telechargeables selon leurs permissions.' },
      { q: 'Les locataires peuvent-ils soumettre une preuve de paiement ?', a: 'Oui. AQAR supporte la soumission de preuves par locataire et la verification par gestionnaire ou comptable dans un workflow structure.' },
      { q: 'AQAR supporte-t-il import et export Excel ?', a: 'Oui. L import/export Excel fait partie de l onboarding et de la sortie afin de migrer depuis les tableurs sans perdre le controle des donnees.' },
      { q: 'Quelle difference avec un PMS importe ?', a: 'AQAR est construit autour des operations locatives Uganda-first, preuves de paiement, versements proprietaires, communication SMS-ready, donnees locataires DPPA-aware et isolation par societe.' },
    ],
  },
};

const c = content[lang];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<BaseLayout lang={lang} title={c.title} description={c.description} pageKey="features" extraSchemas={[faqSchema]}>
  <Lightbox />

  <section class="relative overflow-hidden bg-charcoal">
    <Image src={heroBg} alt="" loading="eager" class="absolute inset-0 h-full w-full object-cover opacity-30" widths={[640, 1024, 1536, 2048]} sizes="100vw" />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/90 to-charcoal/55"></div>
    <div class="relative mx-auto grid min-h-[68vh] max-w-7xl grid-cols-1 items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_0.85fr] lg:px-8">
      <div>
        <h1 class="animate-on-scroll font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">{c.heroTitle}</h1>
        <p class="animate-on-scroll stagger-1 mt-6 max-w-2xl text-lg leading-relaxed text-neutral-200 sm:text-xl">{c.heroSubtitle}</p>
      </div>
      <div class="animate-on-scroll stagger-2 rounded-lg bg-white/[0.06] p-5">
        <Image src={screenshotDashboard} alt="AQAR dashboard feature screen" class="rounded-md" widths={[480, 760, 1024]} sizes="(max-width: 1024px) 92vw, 480px" />
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-[0.75fr_1.25fr] lg:px-8">
      <div>
        <h2 class="font-display text-3xl font-extrabold text-charcoal">{c.directTitle}</h2>
      </div>
      <p class="text-xl leading-relaxed text-neutral-700">{c.directAnswer}</p>
    </div>
  </section>

  {c.sections.map((feature, i) => {
    const isDark = i % 2 === 0;
    const imageLeft = i % 2 === 1;
    const Icon = feature.icon;
    return (
      <section class:list={[isDark ? 'bg-charcoal' : 'bg-surface', 'py-20 sm:py-24']}>
        <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
          <div class:list={[imageLeft && 'lg:order-2']}>
            <div class:list={['flex h-12 w-12 items-center justify-center rounded-md', isDark ? 'bg-primary-500/15 text-primary-300' : 'bg-primary-50 text-primary-700']}>
              <Icon class="h-6 w-6" />
            </div>
            <h2 class:list={['mt-6 font-display text-3xl font-extrabold sm:text-4xl', isDark ? 'text-white' : 'text-charcoal']}>{feature.title}</h2>
            <p class:list={['mt-4 text-lg leading-relaxed', isDark ? 'text-neutral-300' : 'text-neutral-700']}>{feature.desc}</p>
            <ul class="mt-7 space-y-3">
              {feature.bullets.map((bullet) => (
                <li class:list={['flex gap-3 leading-relaxed', isDark ? 'text-neutral-300' : 'text-neutral-700']}>
                  <ShieldCheck class="mt-1 h-5 w-5 shrink-0 text-success-500" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class:list={[imageLeft && 'lg:order-1']}>
            <div class="rounded-xl bg-neutral-900 p-2 shadow-xl">
              <div class="flex items-center gap-1.5 rounded-t-lg bg-neutral-800 px-3 py-2">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
              </div>
              <Image src={feature.image} alt={feature.title} class="max-h-[430px] w-full rounded-b-lg object-cover object-top" widths={[480, 760, 1024]} sizes="(max-width: 1024px) 100vw, 50vw" />
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-extrabold text-charcoal sm:text-4xl">{c.comparisonTitle}</h2>
      <div class="mt-8 overflow-hidden rounded-lg border border-neutral-200">
        <table class="w-full border-collapse text-left">
          <thead class="bg-charcoal text-white">
            <tr>
              <th class="px-5 py-4 text-sm font-bold">{lang === 'en' ? 'Workflow' : 'Workflow'}</th>
              <th class="px-5 py-4 text-sm font-bold">{lang === 'en' ? 'Spreadsheet pattern' : 'Mode tableur'}</th>
              <th class="px-5 py-4 text-sm font-bold">AQAR</th>
            </tr>
          </thead>
          <tbody>
            {c.comparison.map((row) => (
              <tr class="border-t border-neutral-200">
                <th class="bg-surface px-5 py-4 font-display text-sm font-bold text-charcoal">{row[0]}</th>
                <td class="px-5 py-4 text-sm leading-relaxed text-neutral-700">{row[1]}</td>
                <td class="px-5 py-4 text-sm leading-relaxed text-neutral-700">{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-12 w-12 items-center justify-center rounded-md bg-primary-500/15 text-primary-300">
        <Database class="h-6 w-6" />
      </div>
      <h2 class="mt-6 font-display text-3xl font-extrabold text-white">{c.faqTitle}</h2>
      <div class="mt-8 space-y-4">
        {c.faqs.map((faq) => (
          <article class="rounded-lg border border-white/10 bg-white/[0.04] p-6">
            <h3 class="font-display text-lg font-bold text-white">{faq.q}</h3>
            <p class="mt-3 leading-relaxed text-neutral-300">{faq.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner lang={lang} />
</BaseLayout>
